{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.11.11", "generated_at": "2026-05-27T21:12:36.385176Z", "invocation_id": "41a8fc93-af15-43f7-87b4-e598d15f4ad7", "invocation_started_at": "2026-05-27T21:12:36.039230Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-27T21:12:36.337230Z", "completed_at": "2026-05-27T21:12:36.339739Z"}, {"name": "execute", "started_at": "2026-05-27T21:12:36.339854Z", "completed_at": "2026-05-27T21:12:36.339861Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.002892017364501953, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.bluesky_lakehouse.stg_posts", "compiled": true, "compiled_code": "-- analytics/models/staging/stg_posts.sql\n-- Read from Iceberg via DuckDB iceberg_scan. Light cleanup:\n--   - filter out harness test markers\n--   - filter out null text\n--   - add text_length derived column\n\n\n\nSELECT\n    did,\n    time_us,\n    event_time,\n    text,\n    primary_lang,\n    created_at,\n    LENGTH(text) AS text_length\nFROM iceberg_scan(\n    's3://lakehouse/warehouse/bsky/posts',\n    allow_moved_paths = true\n)\nWHERE text IS NOT NULL\n  AND did NOT LIKE 'harness:%'", "relation_name": "\"analytics\".\"main\".\"stg_posts\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-27T21:12:36.340543Z", "completed_at": "2026-05-27T21:12:36.364563Z"}, {"name": "execute", "started_at": "2026-05-27T21:12:36.364686Z", "completed_at": "2026-05-27T21:12:36.364690Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.024402856826782227, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.bluesky_lakehouse.dim_languages", "compiled": true, "compiled_code": "-- analytics/models/marts/dim_languages.sql\n-- Language dimension: first/last seen, total posts, distinct users.\n\n\n\nSELECT\n    primary_lang                AS lang_code,\n    MIN(event_time)             AS first_seen,\n    MAX(event_time)             AS last_seen,\n    COUNT(*)                    AS total_posts,\n    COUNT(DISTINCT did)         AS distinct_users\nFROM \"analytics\".\"main\".\"stg_posts\"\nWHERE primary_lang IS NOT NULL\nGROUP BY primary_lang", "relation_name": "\"analytics\".\"main\".\"dim_languages\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-27T21:12:36.365400Z", "completed_at": "2026-05-27T21:12:36.366526Z"}, {"name": "execute", "started_at": "2026-05-27T21:12:36.366647Z", "completed_at": "2026-05-27T21:12:36.366649Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0016148090362548828, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.bluesky_lakehouse.fct_posts_hourly", "compiled": true, "compiled_code": "-- analytics/models/marts/fct_posts_hourly.sql\n-- Hourly post counts per language with rolling 24h totals.\n\n\n\nWITH hourly AS (\n    SELECT\n        DATE_TRUNC('hour', event_time) AS hour_bucket,\n        primary_lang,\n        COUNT(*)                       AS post_count,\n        AVG(text_length)               AS avg_text_length,\n        SUM(CASE WHEN text_length > 200 THEN 1 ELSE 0 END) AS long_posts\n    FROM \"analytics\".\"main\".\"stg_posts\"\n    GROUP BY DATE_TRUNC('hour', event_time), primary_lang\n)\nSELECT\n    hour_bucket,\n    primary_lang,\n    post_count,\n    avg_text_length,\n    long_posts,\n    SUM(post_count) OVER (\n        PARTITION BY primary_lang\n        ORDER BY hour_bucket\n        ROWS BETWEEN 23 PRECEDING AND CURRENT ROW\n    ) AS rolling_24h_count\nFROM hourly", "relation_name": "\"analytics\".\"main\".\"fct_posts_hourly\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-27T21:12:36.367263Z", "completed_at": "2026-05-27T21:12:36.371122Z"}, {"name": "execute", "started_at": "2026-05-27T21:12:36.371241Z", "completed_at": "2026-05-27T21:12:36.371243Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.004293203353881836, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.bluesky_lakehouse.not_null_stg_posts_did.9053e02bb6", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect did\nfrom \"analytics\".\"main\".\"stg_posts\"\nwhere did is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-27T21:12:36.371771Z", "completed_at": "2026-05-27T21:12:36.373034Z"}, {"name": "execute", "started_at": "2026-05-27T21:12:36.373140Z", "completed_at": "2026-05-27T21:12:36.373142Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0016219615936279297, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.bluesky_lakehouse.not_null_stg_posts_event_time.e736a4acad", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect event_time\nfrom \"analytics\".\"main\".\"stg_posts\"\nwhere event_time is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-27T21:12:36.373645Z", "completed_at": "2026-05-27T21:12:36.375019Z"}, {"name": "execute", "started_at": "2026-05-27T21:12:36.375123Z", "completed_at": "2026-05-27T21:12:36.375125Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0017242431640625, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.bluesky_lakehouse.not_null_stg_posts_text.c18f44a454", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect text\nfrom \"analytics\".\"main\".\"stg_posts\"\nwhere text is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-05-27T21:12:36.375609Z", "completed_at": "2026-05-27T21:12:36.376776Z"}, {"name": "execute", "started_at": "2026-05-27T21:12:36.376881Z", "completed_at": "2026-05-27T21:1